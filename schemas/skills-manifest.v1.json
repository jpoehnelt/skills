{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jpoehnelt/skills/main/schemas/skills-manifest.v1.json",
  "title": "Skills Sync Manifest v1",
  "type": "object",
  "required": ["targetDir", "sources"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "targetDir": {
      "type": "string",
      "minLength": 1,
      "default": ".agents/skills"
    },
    "symlinks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["repo"],
        "additionalProperties": false,
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "default": "main"
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "path"],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "local": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "default": []
    }
  }
}
